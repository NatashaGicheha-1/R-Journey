#Example
library(palmerpenguins)
library(dplyr)
penguins_clean<-penguins%>%drop_na()%>%select(species, island, bill_length_mm, bill_depth_mm, flipper_length_mm, body_mass_g, sex)
library(palmerpenguins)
library(dplyr)
library(tidyr)
penguins_clean<-penguins%>%drop_na()%>%select(species, island, bill_length_mm, bill_depth_mm, flipper_length_mm, body_mass_g, sex)
glimpse(penguins_clean)
set.seed(123)
train_index<-createDataPartition(penguins_clean$species, p=0.7, list=FALSE)
train_data<-penguins_clean[train_index, ]
test_data<-penguins_clean[-train_index, ]
nrow(train_data);nrow(test_data)
set.seed(123)
train_index<-createDataPartition(penguins_clean$species, p=0.7, list=FALSE)
train_data<-penguins_clean[train_index, ]
test_data<-penguins_clean[-train_index, ]
nrow(train_data);nrow(test_data)
#Regression
lm_model<-lm(body_mass_g ~ bill_length_mm + bill_depth_mm + flipper_length_mm, data= train_data)
predictions<-predict(lm_model, newdata=test_data)
#Prediction error in grams
RMSE(predictions, test_data$body_mass_g)
#R-squared on test data
R2(predictions, test_data$body_mass_g)
#Data Visualization with ggplot
#Load ggplot2
library(ggplot2)
#Use mtcars dataset
data(mtcars)
str(mtcars)
#Scatter plot
ggplot(mtcars, aes(cyl, mpg)) + geom_point()
#Interpretation
#Negative relationship among the variables, draw a line it goes downwards
#Cars with 4 cylinders have the highest fuel efficiency ranging from approximately 22mpg-34mpg.
#Cars with 6 cylinders have moderate fuel efficiency ranging from approximately 18mpg-23mpg.
#Cars with 8 cylinders have the lowest fuel efficiency ranging from approximately 11mpg-19mpg.
#aes - aesthetic - maps variables in the function to their respective axis
#Change the Scatter plot command by wrapping factor() around cyl
ggplot(mtcars, aes(factor(cyl), mpg)) + geom_point()
#Difference
#Scale, smaller
#X axis, clearly mentions its categorised
data(iris)
str(iris)
ggplot(iris, aes(Species,Sepal.Length)) + geom_point()
#Edit to add a color aesthetic mapped to disp
ggplot(mtcars, aes(wt, mpg, color=disp)) + geom_point()
#Interpretation
#Dots are in different colors
#3 variables mentioned:mpg, wt and disp
#Darker dots have high fuel efficiency
#Darker dots have a low engine displacement disp
#Difference between the 2 below
ggplot(mtcars, aes(wt, mpg, size=disp)) + geom_point()
#Large dots
ggplot(mtcars, aes(wt, mpg, shape=disp)) + geom_point()
